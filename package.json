{
  "name": "kodeit-todo",
  "productName": "Kodeit Todo",
  "version": "1.0.0",
  "description": "Kodeit Todo \u2014 a personal todo app for the desktop",
  "main": "src/main/main.js",
  "author": "Saurav Tiwari",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "seed": "node scripts/seed.js",
    "release": "node scripts/release.js",
    "dist:signed": "electron-builder --mac --config.mac.notarize=true",
    "fetch-model": "node scripts/fetch-model.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kodeit.todo",
    "productName": "Kodeit Todo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/@huggingface/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/color/**/*",
      "node_modules/color-convert/**/*",
      "node_modules/color-name/**/*",
      "node_modules/color-string/**/*",
      "node_modules/is-arrayish/**/*",
      "node_modules/simple-swizzle/**/*",
      "node_modules/semver/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/protobufjs/**/*",
      "node_modules/@protobufjs/**/*",
      "node_modules/long/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/tar/**/*",
      "node_modules/flatbuffers/**/*",
      "node_modules/guid-typescript/**/*",
      "node_modules/minipass/**/*",
      "node_modules/minizlib/**/*",
      "node_modules/chownr/**/*",
      "node_modules/mkdirp/**/*",
      "node_modules/yallist/**/*",
      "!node_modules/@huggingface/transformers/.cache/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**/*",
      "!node_modules/onnxruntime-web/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kodeit Todo uses the microphone only when you press the dictation button, to turn what you say into a task. The audio is transcribed on this Mac and never leaves it."
      }
    },
    "afterPack": "scripts/adhoc-sign.js",
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "models/**/*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
